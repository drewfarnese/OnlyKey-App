{
  "name": "onlykey-app",
  "productName": "OnlyKey App",
  "version": "5.5.0",
  "version_name": "5.5.0",
  "description": "Setup and configure OnlyKey",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "NODE_ENV=development electron .",
    "build": "gulp build",
    "build_win": "gulp build",
    "prerelease": "rm -rf ./node_modules/* && pnpm install --prod && rm -rf ./release_node_modules && mkdir release_node_modules && cd release_node_modules && mkdir node_modules && cd .. && cp -R ./node_modules/* ./release_node_modules/node_modules && pnpm install && pnpm run build --env=production",
    "prerelease_win": "rm -rf ./node_modules/* && pnpm install --prod && rm -rf ./release_node_modules && mkdir release_node_modules && cd release_node_modules && mkdir node_modules && cd .. && cp -R ./node_modules/* ./release_node_modules/node_modules && pnpm install && pnpm run build_win --env=production",
    "release": "gulp release --env=production",
    "release_win": "gulp release --env=production",
    "pretest": "pnpm run build",
    "test": "mocha 'test/**/*.mjs'",
    "testgulp": "gulp -v",
    "prechrome": "gulp build --env=chrome",
    "chrome": "echo 'Please run something like:'; echo \"chrome --load-and-launch-app=$(pwd)/build\""
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "auto-launch": "^5.0.5",
    "electron": "^35.1.5",
    "js-sha256": "^0.11.1",
    "sshpk": "^1.17.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.0.1",
    "fs-jetpack": "^5.1.0",
    "gulp": "^5.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "json": "^11.0.0",
    "mocha": "^11.7.5",
    "selenium-webdriver": "^4.8.0",
    "tree-kill": "^1.2.2",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustcrypto/OnlyKey-App.git"
  },
  "keywords": [
    "OnlyKey",
    "CryptoTrust",
    "two-factor",
    "password",
    "FIDO2",
    "security",
    "key"
  ],
  "author": "CryptoTrust <admin@crp.to>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://onlykey.discourse.group/"
  },
  "homepage": "https://github.com/trustcrypto/OnlyKey-App#readme",
  "window": {
    "icon": "icon.png",
    "show": true,
    "toolbar": true,
    "width": 1000,
    "height": 600,
    "min_width": 800,
    "min_height": 400,
    "position": "center"
  }
}
